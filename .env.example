# Copier ce fichier en .env et renseigner les valeurs. Ne jamais committer .env.

# development | test | production (défaut : production)
ENVIRONMENT=development

# MongoDB (Prisma)
DATABASE_URL=mongodb+srv://<utilisateur>:<mot_de_passe>@<cluster>/<base>

# Clé de signature JWT : au moins 32 caractères, différente par environnement.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<a_generer>
# Durée de validité du token en minutes (défaut 480 = 8 h, maximum 720 = 12 h)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Tarif unique d'inscription en FCFA (référence pour les reçus et les finances)
REGISTRATION_FEE=6000

# Taille maximale d'une image téléversée, en octets (5 Mo)
MAX_UPLOAD_BYTES=5242880

# Origines CORS autorisées, séparées par des virgules (le format JSON est aussi accepté).
# http://localhost:3000 est ajouté automatiquement hors production.
CORS_ORIGINS=https://an-nour25.vercel.app,https://annourpwa.netlify.app

# Cloudinary
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Inscription System
MEDIA_DIR=media
